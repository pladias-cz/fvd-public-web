{block head}{/block}
{block scripts}
<script type="text/javascript">
    let image_copyright_1 = {_taxon.images.copyright_1}
    image_accept = {_taxon.images.accept};
    map_info_1 = {_taxon.map.info_1};
    map_info_2 = {_taxon.map.info_2};
    map_info_3 = {_taxon.map.info_3};
    map_info_4 = {_taxon.map.info_4};
    mapCloseText = {_taxon.map.close}
</script>
{/block}
{block content}

<div class="d-grid grid-80-20 mapRow bg-light">
    <div>
        {* mapa samotná *}
        <div id="map" style="height: 30rem; width: auto;" data-taxon="{$taxon->id}"></div>
    </div>
    <div style="width: auto; max-width: 13rem;" class='px-3'>
        {* nastavení *}
        <h3 class="mt-2 mb-1">{_taxon.map.mapSettings}</h3>
        <h4 class='mt-2 mb-1'>{_taxon.map.layers}</h4>
        <div class="custom-control custom-radio">
            <input type="radio" id="baseLayerOSM" name="mapType" class="custom-control-input" checked>
            <label class="custom-control-label" for="baseLayerOSM">{_taxon.map.basic}</label>
        </div>
        <div class="custom-control custom-radio">
            <input type="radio" id="baseLayerOpenTopo" name="mapType" class="custom-control-input">
            <label class="custom-control-label" for="baseLayerOpenTopo">{_taxon.map.terrain}</label>
        </div>

        <div class="custom-control custom-checkbox mt-2">
            <input type="checkbox" class="custom-control-input" id="grid" checked>
            <label class="custom-control-label" for="grid">{_taxon.map.showGrid}</label>
        </div>

        <div class="list-group d-none" id="timeboundary_layer">
            <div class="mt-2">
                <button type="button" class="btn btn-primary py-1 mt-3">{_taxon.map.legend.time.switch}</button>
            </div>
            <p class="my-1">{_taxon.map.timespan}: {$oldestRecord}&ndash;{date('Y')}</p>
            <div class="range-slider">
                <input id="timeBorderlineSlider" class="range-slider_input" type="range" value="2000"
                       min="{$oldestRecord}" max="{date('Y')}">
                <p><i class="circleMap magentaGrid"></i> {_taxon.map.beforeYear} <span
                    class="range-slider_value">0</span></p>
            </div>

        </div>
        <div class="list-group" id="semafor_layer">
            <div class="mt-2">
                <button type="button" class="btn btn-primary py-1 mt-3">{_taxon.map.legend.semafor.switch}</button>
            </div>
        </div>
        <p class="mt-3 mb-0" style='line-height: 1.5'>
            <span data-toggle="tooltip" class="help"
                  title="{_taxon.map.legend.notrevised}">{_taxon.map.legend.legend}</span>:<br>
            <i class="circleMap green"></i> {_taxon.map.revised}<br>
            <i class="circleMap grey"></i> {_taxon.map.unrevised}<br>
            <i class="circleMap orangeSemafor"></i> {_taxon.map.uncertain}
        </p>
        <p class="mt-2 small"><a n:href="Download:distribution $taxon->id">{_taxon.map.downloadData}</a></p>
    </div>
</div>

<div class="d-flex justify-content-between align-content-center mb-3">
    <h3 class="mb-0"><i>{$taxon->nameLat}</i> – {$taxon->getName($locale)}</h3>
</div>

<h4>Data</h4>
{*TODO kolik odkud záznamů + vždy jeden záznam z kvadrantu s nějakými detaily (origname na gbif atp).*}

<div class="d-grid grid-auto gap-2">
    
    <div n:if="count($taxon->bayernTaxa) > 0">
        <h5 class="p-2 bg-light rounded">SNSB Münich</h5>
        {foreach $taxon->bayernTaxa as $bayern}
        {$bayern->nameLatFull}
        {/foreach}
    </div>

    <div n:if="count($taxon->pladiasTaxa) > 0">
        <h5 class="p-2 bg-light rounded">Pladias</h5>
        {foreach $taxon->pladiasTaxa as $pladias}
        {$pladias->nameLatin}
        {/foreach}
    </div>

    <div n:if="count($taxon->distributionNonautomatic) > 0">
        <h5 class="p-2 bg-light rounded">Distribution Manual</h5>
        <ul>
            {foreach $taxon->distributionNonautomatic as $zmizik}
            <li>
                <strong>{$zmizik->quadrant->code}</strong> –
                {$zmizik->status->description}
                <small>
                    ({if $zmizik->createdByMachine}{_taxon.distributionManual.automatic}{else}{_taxon.distributionManual.manual}{/if})
                </small>
            </li>
            {/foreach}
        </ul>
    </div>

    <div n:if="count($taxon->pladiasTaxa) > 0">
        <h5 class="p-2 bg-light rounded">GBIF</h5>
        <ul>
            {foreach $taxon->pladiasTaxa as $pladias}
                {foreach $pladias->gbifTaxa as $gbif}
                    <li>
                        <span>{$gbif->scientificName}</span> –
                        <a href="https://www.catalogueoflife.org/data/taxon/{$gbif->colTaxonId}">
                            <small>{$gbif->colTaxonId}</small>
                        </a>
                    </li>
                {/foreach}
            {/foreach}
        </ul>
    </div>

    <div n:if="count($austriaOnly) > 0">
        <h5 class="p-2 bg-light rounded">GBIF Austria only</h5>
        <ul class="mb-0">
            {foreach $austriaOnly as $austriaGbif}
                <li>
                    <strong>{$austriaGbif->scientificName}</strong> –
                    <a href="https://www.catalogueoflife.org/data/taxon/{$austriaGbif->colTaxonId}">
                        <small>
                            {$austriaGbif->colTaxonId}
                        </small>
                    </a>
                </li>
            {/foreach}
        </ul>
    </div>


</div>


{/block}
