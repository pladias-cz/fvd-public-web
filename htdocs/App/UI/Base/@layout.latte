<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Emoji:wght@300..700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:400,400i,600,700,700i&display=swap&subset=latin-ext" rel="stylesheet">
    <link rel="shortcut icon" href="{$basePath}/images/favicon.svg">
    {encore_css 'app'}
    {if $presenter->isLinkCurrent('Species:*') || $presenter->isLinkCurrent('Home:default') || $presenter->isLinkCurrent('Home:publicity')}
    {encore_js 'gallery'}
    {encore_css 'gallery'}
    {/if}

    <title>{_base.project.name}</title>
</head>

<script>
  (function () {
    const GA_ID = 'G-SG3C28V4YV';
    const KEY_ACCEPTED = 'cookiesOverlayAccepted';

    window.loadAnalytics = window.loadAnalytics || function () {
      if (document.getElementById('ga-script')) {
        return;
      }

      const script = document.createElement('script');
      script.id = 'ga-script';
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
      document.head.appendChild(script);

      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () {
        window.dataLayer.push(arguments);
      };

      window.gtag('js', new Date());
      window.gtag('config', GA_ID);
    };

    if (localStorage.getItem(KEY_ACCEPTED) === '1') {
      window.loadAnalytics();
    }
  })();
</script>

<body>
{include navigation}

<div data-data="cookie-consent" class="cookies-consent-overlay d-none cookie-banner cookie-consent">
  <div class="bg-light rounded p-3 m-2" style="max-width: 500px">
  <p>{_base.cookies.message}</p>
  <p>{_base.cookies.message2}</p>
  <div class="d-flex gap-2 jc-end ai-center">
    <button data-data="cookies-decline">{_base.action.decline}</button>
    <button data-data="cookies-accept">{_base.action.accept}</button>
  </div>
  </div>
</div>

<div id="content" class="container">
{include content}
</div>

{block footer}
<footer class="container d-grid grid-2">

<div>{_base.social_media}: <a href="https://www.instagram.com/crossborderplants/">Instagram</a> &bullet; <a href="https://www.facebook.com/groups/1153309673196666">Facebook</a> &bullet; <a href="https://bsky.app/profile/crossborderplants.bsky.social">BlueSky</a> &bullet; <a href="https://x.com/c_border_plants">X</a></div>

<div class="text-right"><a href="#" class="cookie-consent-overlay-toggle" data-cookie-allowed="{_base.value.allowed}" data-cookie-declined="{_base.value.declined}">{_base.cookies.setting}</a><span data-data="cookie-consent-status"></span> &bullet; 2025{if date('Y') > 2025}&ndash;{date('Y')}{/if} &bullet; {_base.project.name}</div>

</footer>
{/block}

</body>
{encore_js 'app'}
</html>
